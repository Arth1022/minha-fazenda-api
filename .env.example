# Variáveis do perfil prod. Copie para .env (que não vai para o repositório) e preencha.
DB_URL=jdbc:postgresql://<host do session pooler>:5432/postgres
DB_USER=postgres.<ref do projeto>
DB_PASS=
JWT_PRIVATE_KEY=
JWT_KID=
POWERSYNC_URL=
STORAGE_ENDPOINT=https://<ref do projeto>.storage.supabase.co/storage/v1/s3
STORAGE_REGION=sa-east-1
STORAGE_KEY=
STORAGE_SECRET=
STORAGE_BUCKET=avatars
STORAGE_BUCKET_MIDIAS=midias
STORAGE_PUBLIC_URL=https://<ref do projeto>.supabase.co/storage/v1/object/public/avatars
APP_LINK_BASE=
SYNC_MIN_SCHEMA_VERSION=1
